<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الملف الشخصي</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="/style.css" rel="stylesheet">

</head>

<body>
    <%- include('partials/navbar') %>
        <%- include('partials/sidebar') %>

            <div class="container-fluid main-content px-4 px-lg-5">
                <% if (typeof success !=='undefined' && success) { %>
                    <div class="alert alert-success">
                        <%= typeof success === 'string' ? success : 'تم التحديث بنجاح!' %>
                    </div>
                <% } %>

                <% if (typeof error !=='undefined' && error) { %>
                    <div class="alert alert-danger">
                        <%= error %>
                    </div>
                <% } %>

                <!-- Bot Identity Settings Card -->
                <div class="glass-card p-4 p-md-5 animate-fade-in mb-4">
                    <h3 class="mb-4 fw-bold border-bottom border-primary border-opacity-25 pb-3">إعدادات هوية البوت</h3>
                    
                    <form action="/dashboard/profile/update-settings" method="POST" enctype="multipart/form-data">
                        <div class="row align-items-center mb-4">
                            <div class="col-md-3 text-center mb-3 mb-md-0">
                                <label class="d-block text-secondary mb-2">شعار البوت الحالي</label>
                                <div class="position-relative d-inline-block">
                                    <img id="logo-preview" src="<%= (user.settings && user.settings.bot_logo) ? user.settings.bot_logo : '/whatsapp_logo.png' %>" 
                                         alt="Bot Logo" class="rounded-circle border border-primary border-2 shadow" 
                                         style="width: 120px; height: 120px; object-fit: cover; background: #000;">
                                </div>
                            </div>
                            <div class="col-md-9">
                                <div class="mb-4">
                                    <label class="form-label text-secondary">اسم البوت</label>
                                    <input type="text" name="bot_name" class="form-control" 
                                           placeholder="AI Whatsapp" 
                                           value="<%= (user.settings && user.settings.bot_name) ? user.settings.bot_name : 'AI Whatsapp' %>" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-secondary">تحميل شعار جديد</label>
                                    <input type="file" name="bot_logo" id="bot-logo-input" class="form-control" accept="image/*">
                                    <div class="form-text text-white-50">تنسيقات الصور المدعومة: JPEG, PNG, WebP (الحد الأقصى 5 ميجابايت)</div>
                                </div>
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary px-5 py-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-save-fill me-2" viewBox="0 0 16 16">
                                <path d="M8.5 1.5A1.5 1.5 0 0 1 10 0h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h6v1.5zm.5 0v3a.5.5 0 0 0 .5.5H13v-3.5a.5.5 0 0 0-.5-.5H9.5a.5.5 0 0 0-.5.5z"/>
                            </svg>
                            حفظ الإعدادات
                        </button>
                    </form>
                </div>

                <!-- Security Settings Card -->
                <div class="glass-card p-4 p-md-5 animate-fade-in">
                    <h3 class="mb-4 fw-bold border-bottom border-primary border-opacity-25 pb-3">إعدادات الأمان</h3>

                    <form action="/dashboard/profile/password" method="POST">
                        <div class="mb-4">
                            <label class="form-label text-secondary">كلمة المرور الحالية</label>
                            <input type="password" name="currentPassword" class="form-control" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-secondary">كلمة المرور الجديدة</label>
                            <input type="password" name="newPassword" class="form-control" minlength="6"
                                required>
                            <div class="form-text text-white-50">يجب أن تكون 6 أحرف على الأقل.
                            </div>
                        </div>
                        <div class="mb-5">
                            <label class="form-label text-secondary">تأكيد كلمة المرور
                                الجديدة</label>
                            <input type="password" name="confirmPassword" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-primary px-5 py-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                fill="currentColor" class="bi bi-shield-lock-fill me-2"
                                viewBox="0 0 16 16">
                                <path fill-rule="evenodd"
                                    d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm0 5a1.5 1.5 0 0 1 .5 2.915l.385 1.99a.5.5 0 0 1-.491.595h-.792a.5.5 0 0 1-.492-.595l.385-1.99A1.5 1.5 0 0 1 8 5z" />
                            </svg>
                            تحديث كلمة المرور
                        </button>
                    </form>
                </div>
            </div>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <script>
                // Live image preview
                document.getElementById('bot-logo-input').addEventListener('change', function(event) {
                    const file = event.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            document.getElementById('logo-preview').src = e.target.result;
                        }
                        reader.readAsDataURL(file);
                    }
                });
            </script>
</body>

</html>